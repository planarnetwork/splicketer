{
  "compilerOptions": {
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "target": "es2024",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "lib": ["es2024"],
    "types": ["node"]
  },
  "include": ["src", "test"]
}
